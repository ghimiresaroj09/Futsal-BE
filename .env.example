# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
DJANGO_SETTINGS_MODULE=config.settings.development
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=Asia/Kathmandu

# Database
# Either set the discrete DB_* variables below, or a single DATABASE_URL
# (DATABASE_URL wins when both are set).
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/futsal

# Email
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@futsal.local

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# JWT (minutes / days)
JWT_ACCESS_TOKEN_LIFETIME=15
JWT_REFRESH_TOKEN_LIFETIME=7

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Business rules
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_PER_HOUR=5
BOOKING_REFERENCE_PREFIX=FSL
REMINDER_LEAD_MINUTES=60
REMINDER_WINDOW_MINUTES=10

# Throttling
THROTTLE_LOGIN=10/min
THROTTLE_OTP=5/min
THROTTLE_REGISTER=10/hour
THROTTLE_CONTACT=10/hour
LOG_LEVEL=INFO

# MongoDB structured production logs. Keep this URI secret and set it only in
# the production environment. Leave blank to disable MongoDB log storage.
MONGODB_LOG_URI=
MONGODB_LOG_DATABASE=futsal_logs
MONGODB_LOG_COLLECTION=application_logs
MONGODB_LOG_LEVEL=INFO
LOG_ENVIRONMENT=development

# Cloudinary (images & videos). Leave credentials blank to use MEDIA_ROOT locally.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=futsal
# USE_CLOUDINARY=True
MAX_IMAGE_UPLOAD_MB=5
MAX_VIDEO_UPLOAD_MB=100

# Deployment / cron. Empty CRON_SECRET makes the endpoint reject every request.
CRON_SECRET=
CSRF_TRUSTED_ORIGINS=https://*.onrender.com
